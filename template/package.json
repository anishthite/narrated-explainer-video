{
  "name": "explainer-video",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "draft": "remotion render src/index.ts Explainer out/draft.mp4 --scale=0.5 --crf=23 --image-format=jpeg --jpeg-quality=85",
    "render": "remotion render src/index.ts Explainer out/.raw.mp4 --codec=h264 --crf=18 --image-format=jpeg --jpeg-quality=92 --color-space=bt709",
    "still": "remotion still src/index.ts Explainer --scale=0.5"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.6.3"
  }
}
